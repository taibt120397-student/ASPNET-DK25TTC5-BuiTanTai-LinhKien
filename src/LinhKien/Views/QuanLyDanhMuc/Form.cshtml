@using Microsoft.AspNetCore.Mvc.Rendering
@model LinhKien.ViewModels.DanhMucFormVM
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Thêm danh mục" : "Sửa danh mục";
    var parents = (List<SelectListItem>)ViewBag.ParentList;
}

<h1 class="h3 mb-3">@ViewData["Title"]</h1>

<form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? null : Model.Id)" method="post" class="col-lg-6 p-0">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="TenDanhMuc" class="form-label"></label>
        <input asp-for="TenDanhMuc" class="form-control" autofocus />
        <span asp-validation-for="TenDanhMuc" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Slug" class="form-label"></label>
        <input asp-for="Slug" class="form-control" placeholder="vd: cam-bien-nhiet-do" />
        <span asp-validation-for="Slug" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="DanhMucChaId" class="form-label"></label>
        <select asp-for="DanhMucChaId" asp-items="parents" class="form-select">
            <option value="">— Danh mục gốc (không có cha) —</option>
        </select>
        <span asp-validation-for="DanhMucChaId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ThuTu" class="form-label"></label>
        <input asp-for="ThuTu" type="number" min="0" class="form-control" />
        <span asp-validation-for="ThuTu" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Lưu</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
