@model List<LinhKien.ViewModels.DanhMucRow>
@{
    ViewData["Title"] = "Quản lý danh mục";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Danh mục sản phẩm</h1>
    <a class="btn btn-primary" asp-action="Create">+ Thêm danh mục</a>
</div>

<partial name="_ThongBao" />

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Tên danh mục</th>
                <th>Slug</th>
                <th class="text-center">Thứ tự</th>
                <th class="text-center">Danh mục con</th>
                <th class="text-center">Sản phẩm</th>
                <th class="text-end">Thao tác</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td style="padding-left:@(r.Level * 24 + 12)px">
                    @(r.Level > 0 ? "└ " : "")<span class="@(r.Level == 0 ? "fw-semibold" : "")">@r.Ten</span>
                </td>
                <td class="text-muted small">@r.Slug</td>
                <td class="text-center">@r.ThuTu</td>
                <td class="text-center">@r.SoCon</td>
                <td class="text-center">@r.SoSanPham</td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@r.Id">Sửa</a>
                    <form asp-action="Delete" asp-route-id="@r.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Xóa danh mục “@r.Ten”?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                    </form>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="6" class="text-center text-muted py-4">Chưa có danh mục nào.</td></tr>
        }
        </tbody>
    </table>
</div>
