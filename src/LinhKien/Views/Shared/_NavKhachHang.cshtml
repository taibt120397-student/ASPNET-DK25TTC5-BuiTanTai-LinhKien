@* Chèn <partial name="_NavKhachHang" /> trong _Layout.cshtml, ngay TRƯỚC <partial name="_LoginPartial" /> *@
<form id="frmTimKiem" class="d-flex position-relative me-sm-3 my-2 my-sm-0" action="/san-pham" method="get" role="search" autocomplete="off">
    <input name="q" class="form-control form-control-sm" type="search" data-goi-y
           placeholder="Tìm linh kiện hoặc mã SP..." aria-label="Tìm kiếm" style="min-width:240px" />
</form>

<a class="nav-link text-dark me-2" asp-controller="GioHang" asp-action="Index">
    Giỏ hàng <span id="gioHangBadge" class="badge rounded-pill text-bg-danger d-none">0</span>
</a>

@* Token chống CSRF cho các lệnh AJAX; cờ đăng nhập cho JavaScript *@
<form id="afForm" class="d-none">@Html.AntiForgeryToken()</form>
<span id="cuaHangCfg" class="d-none" data-auth="@(User.Identity?.IsAuthenticated == true ? "1" : "0")"></span>
<script src="~/js/cua-hang.js" asp-append-version="true" defer></script>
<script src="~/js/giao-dien.js" asp-append-version="true" defer></script>
