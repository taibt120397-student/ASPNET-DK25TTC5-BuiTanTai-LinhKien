@model LinhKien.ViewModels.HoSoVM
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
}
<div class="row g-4">
    <aside class="col-lg-3"><partial name="_TaiKhoanMenu" /></aside>
    <section class="col-lg-9">
        <h1 class="h3 mb-3">Hồ sơ cá nhân</h1>
        <partial name="_ThongBao" />
        <form asp-action="Index" method="post" class="col-lg-7 p-0">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input class="form-control" value="@Model.Email" disabled />
                <div class="form-text">Email dùng để đăng nhập, không đổi được ở đây.</div>
            </div>
            <div class="mb-3">
                <label asp-for="HoTen" class="form-label"></label>
                <input asp-for="HoTen" class="form-control" />
                <span asp-validation-for="HoTen" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label"></label>
                <input asp-for="PhoneNumber" class="form-control" inputmode="tel" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
        </form>
    </section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
